<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net472</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<RootNamespace>CGTargetablePortraits</RootNamespace>
		<AssemblyName>CGTargetablePortraits</AssemblyName>
		<OutputPath>../Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<LangVersion>11.0</LangVersion>
		<!-- TacticalGroups.dll targets .NET 4.8; without this, ResolveAssemblyReference
		     drops the reference (MSB3274) and no TacticalGroups type can be used. -->
		<ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
		<!-- Suppress CS0436 noise: Publicizer injects IgnoresAccessChecksToAttribute which
		     conflicts with the same attribute defined in 0Harmony. -->
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<PublicizeAll>true</PublicizeAll>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4488-beta" />
		<PackageReference Include="Lib.Harmony" Version="2.3.*" />
		<Reference Include="TacticalGroups">
			<HintPath>TacticalGroups.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
