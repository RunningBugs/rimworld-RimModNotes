<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RitualOutcomeSelection</RootNamespace>
    <AssemblyName>RitualOutcomeSelection</AssemblyName>
    <OutputPath>../Assemblies</OutputPath>
    <VersionPrefix>0.1.0.0</VersionPrefix>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugSymbols>false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
    <Publicize Include="Assembly-CSharp:RimWorld.Dialog_BeginRitual.ritual" />
    <Publicize Include="Assembly-CSharp:RimWorld.Dialog_BeginRitual.outcome" />
    <Publicize Include="Assembly-CSharp:RimWorld.LordJob_Ritual.RitualFinished" />
  </ItemGroup>
</Project>