<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' != '1.7'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.5'">$(DefineConstants);RW15</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CultistKidnapping</AssemblyName>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.4409" Condition="'$(RimWorldVersion)' == '1.5'" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" Condition="'$(RimWorldVersion)' == '1.6'" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" Condition="'$(RimWorldVersion)' == '1.7'" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" Condition="'$(RimWorldVersion)' != '1.7'" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" Condition="'$(RimWorldVersion)' == '1.7'" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp:Verse.AI.Group.PsychicRitualToil_SkipAbduction.ApplyOutcome" />
  </ItemGroup>
</Project>
