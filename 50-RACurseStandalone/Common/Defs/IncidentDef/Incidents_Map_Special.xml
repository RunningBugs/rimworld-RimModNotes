<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- 随机诅咒：从当前未激活的诅咒中随机挑一个 -->
	<IncidentDef ParentName="AnomalyIncidentBase">
		<defName>RA_Curse_SA</defName>
		<label>curse (random)</label>
		<category>ThreatSmall</category>
		<targetTags>
		  <li>Map_PlayerHome</li>
		</targetTags>
		<workerClass>RACurseSA.IncidentWorker_Curse</workerClass>
		<gameCondition>RACurseSA_CurseCondition</gameCondition>
		<letterLabel>Curse falls</letterLabel>
		<letterDef>ThreatBig</letterDef>
		<baseChance>0</baseChance>
		<minAnomalyThreatLevel>1</minAnomalyThreatLevel>
		<earliestDay>15</earliestDay>
		<minRefireDays>30</minRefireDays>
		<disabledWhen>
		  <extremeWeatherIncidentsDisabled>true</extremeWeatherIncidentsDisabled>
		</disabledWhen>
		<durationDays>1~3</durationDays>
		<modExtensions>
		  <li Class="RACurseSA.CurseExtension">
			<curse>Random</curse>
		  </li>
		</modExtensions>
	</IncidentDef>

