<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NSMP</RootNamespace>
    <AssemblyName>NSMP</AssemblyName>
    <OutputPath>../Assemblies</OutputPath>
    <VersionPrefix>0.1.0.0</VersionPrefix>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>11.0</LangVersion>
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>
  <PropertyGroup>
    <PublicizeAll>false</PublicizeAll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="Assembly-CSharp:RimWorld.OutfitDatabase.outfits" />
    <Publicize Include="Assembly-CSharp:RimWorld.FoodRestrictionDatabase.foodRestrictions" />
  </ItemGroup>
</Project>