<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">/Data/SteamLibrary/steamapps/common/RimWorld</RimWorldDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">/Data/SteamLibrary/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="$(RimWorldDir)/Waylith.dll" Private="false" />
    <Reference Include="$(RimWorldDir)/Waylith.UnityCompat.dll" Private="false" />
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
